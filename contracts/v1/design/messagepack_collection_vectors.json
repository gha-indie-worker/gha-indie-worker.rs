{
  "schema": "oreslang.messagepack.collections.v2",
  "format": "MessagePack",
  "status": "Java standalone codec v2 implemented and exact-source CI pending; native and actor-runtime transport parity pending",
  "envelope": [
    "wire_format_version_i64_2",
    "schema_id_utf8",
    "sha256_canonical_shape_descriptor_as_bin32",
    "schema_guided_payload"
  ],
  "spec": "https://github.com/msgpack/msgpack/blob/master/spec.md",
  "scalar_subset": [
    "bool",
    "signed_i64",
    "finite_float64",
    "utf8_string"
  ],
  "limits": {
    "max_bytes": 1048576,
    "max_nodes": 100000,
    "max_depth": 64,
    "max_sequence_elements": 100000,
    "max_schema_id_ascii_bytes": 256
  },
  "kind_rule": "Decoder verifies SHA-256 over oreslang.actor.shape.v2/ + canonical collection type grammar (B,I,F,S,T[...],FA[...],FL[...],A[...],L[...]); caller schema ID alone is never trusted.",
  "ownership_rule": "Serialize at send call; snapshot immutable mailbox value; no writable aliases. rt copy is an optional semantically equivalent local optimization after executable benchmarks.",
