{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oreslang.dev/schemas/conformance/report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "backend": {
      "enum": [
        "llvm",
        "graal"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "observed_exit_code": {
            "type": "integer"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0
          },
          "diagnostic": {
            "type": "string"
          }
        }
      }
    }
  }
}
