{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oreslang.dev/schemas/conformance/suite-v1.schema.json",
  "title": "Oreslang conformance suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "java_reference",
    "llvm_reference",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "java_reference": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "llvm_reference": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "feature",
        "file",
        "admission",
        "backends"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^fixtures/[a-z0-9][a-z0-9-]*\\.ores$"
        },
        "admission": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "backends": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "llvm",
            "graal"
          ],
          "properties": {
            "llvm": {
              "enum": [
                "required",
                "pending"
              ]
            },
            "graal": {
              "enum": [
                "required",
                "pending"
              ]
            }
          }
        },
        "pending_reason": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}
