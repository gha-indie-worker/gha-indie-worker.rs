{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oreslang.dev/conformance/actor-trace-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "complete",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "complete": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "kind",
        "actor"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "spawn",
            "admit",
            "send",
            "receive",
            "exclusive_acquire",
            "exclusive_release",
            "terminate"
          ]
        },
        "actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "message_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "resource": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "send"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "target",
              "message_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "receive"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "message_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "exclusive_acquire",
                  "exclusive_release"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "resource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "admit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "message_id"
            ]
          }
        }
      ]
    }
  }
}
