{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gha-indie-worker.fleet-inventory/v1",
  "type": "object",
  "required": ["schema", "generated_at", "hosts"],
  "properties": {
    "schema": {"const": "gha-indie-worker.fleet-inventory/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host_id", "owner", "os", "architecture", "trust_tier", "status", "profiles", "image_generation", "patch_state", "capacity", "recovery"],
        "properties": {
          "host_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "os": {"enum": ["linux", "macos", "windows"]},
          "architecture": {"enum": ["x86_64", "arm64"]},
          "trust_tier": {"enum": ["untrusted", "trusted-release", "signing"]},
          "status": {"enum": ["active", "draining", "maintenance", "quarantined", "offline", "decommissioned"]},
          "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "image_generation": {"type": "string", "minLength": 1},
          "patch_state": {"enum": ["current", "stale", "emergency"]},
          "capacity": {"type": "object", "required": ["max_concurrent_jobs"], "properties": {"max_concurrent_jobs": {"type": "integer", "minimum": 1}}},
          "recovery": {"type": "object", "required": ["method", "last_drill_at"], "properties": {"method": {"type": "string", "minLength": 1}, "last_drill_at": {"type": "string", "format": "date-time"}}},
          "quarantine_reason": {"type": ["string", "null"]},
          "accepts_untrusted_jobs": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
