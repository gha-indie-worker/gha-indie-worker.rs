{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gha-indie-worker.fleet-inventory/v1",
  "type": "object",
  "required": ["schema", "generated_at", "hosts"],
  "properties": {
    "schema": {"const": "gha-indie-worker.fleet-inventory/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host_id",
          "owner",
          "location",
          "asset_reference",
          "os",
          "architecture",
          "hardware_class",
          "trust_tier",
          "state",
          "profiles",
          "image_generation",
          "patch_state",
          "maintenance_ring",
          "agent_version",
          "protocol_version",
          "device_identity",
          "capability_digest",
          "capacity",
          "recovery",
          "last_seen_at",
          "accepts_untrusted_jobs"
        ],
        "properties": {
          "host_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"},
          "owner": {"type": "string", "minLength": 1, "maxLength": 128},
          "location": {"type": "string", "minLength": 1, "maxLength": 128},
          "asset_reference": {"type": "string", "minLength": 1, "maxLength": 128},
          "os": {"enum": ["linux", "macos", "windows"]},
          "architecture": {"enum": ["x64", "arm64"]},
          "hardware_class": {"type": "string", "minLength": 1, "maxLength": 128},
          "trust_tier": {"enum": ["public-untrusted", "public-trusted", "private-build", "release-signing"]},
          "state": {"enum": ["enrolling", "healthy", "busy", "draining", "maintenance", "quarantined", "offline", "revoked"]},
          "profiles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["name", "digest"],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          },
          "image_generation": {"type": "string", "minLength": 1, "maxLength": 128},
          "patch_state": {"enum": ["current", "stale", "emergency"]},
          "maintenance_ring": {"enum": ["canary", "stable", "emergency"]},
          "agent_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
          "protocol_version": {"const": 1},
          "device_identity": {
            "type": "object",
            "required": ["key_id", "expires_at", "revoked"],
            "properties": {
              "key_id": {"type": "string", "pattern": "^device:[a-z0-9][a-z0-9.-]{2,63}:[0-9a-f]{16}$"},
              "expires_at": {"type": "string", "format": "date-time"},
              "revoked": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "capability_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "capacity": {
            "type": "object",
            "required": ["max_concurrent_jobs", "active_jobs"],
            "properties": {
              "max_concurrent_jobs": {"type": "integer", "minimum": 1, "maximum": 32},
              "active_jobs": {"type": "integer", "minimum": 0, "maximum": 32}
            },
            "additionalProperties": false
          },
          "recovery": {
            "type": "object",
            "required": ["method", "last_drill_at", "maximum_recovery_minutes"],
            "properties": {
              "method": {"type": "string", "minLength": 1, "maxLength": 128},
              "last_drill_at": {"type": "string", "format": "date-time"},
              "maximum_recovery_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}
            },
            "additionalProperties": false
          },
          "last_seen_at": {"type": "string", "format": "date-time"},
          "quarantine_reason": {"type": ["string", "null"], "maxLength": 512},
          "accepts_untrusted_jobs": {"type": "boolean"},
          "support_reference": {"type": ["string", "null"], "maxLength": 256},
          "decommissioned_at": {"type": ["string", "null"], "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
