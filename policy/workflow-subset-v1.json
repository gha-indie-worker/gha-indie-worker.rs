{
  "schema": "gha-indie-worker.capabilities/v1",
  "events": {
    "allowed": ["push", "pull_request", "workflow_dispatch"],
    "denied": ["pull_request_target", "workflow_run"]
  },
  "permissions": {
    "allowed": ["none", "read"],
    "write_tokens": false,
    "id_token": false
  },
  "runner_target": {
    "platforms": ["linux", "macos", "windows"],
    "architectures": ["x64", "arm64"],
    "trust_tiers": ["public-untrusted", "public-trusted", "private-build", "release-signing"],
    "fixed_profile_name_and_sha256_digest_required": true,
    "capabilities_sorted_unique_maximum": 64,
    "native_required_for": ["macos", "windows"],
    "aliases_fail_closed": ["x86_64", "amd64", "aarch64", "darwin", "win32"]
  },
  "steps": {
    "maximum": 100,
    "kinds": ["run", "uses"],
    "actions_must_use_commit_sha": true,
    "container_images_must_use_sha256_digest": true,
    "unsupported_expressions_fail_before_execution": true
  },
  "resources": {
    "timeout_seconds_max": 3600,
    "log_bytes_max": 10485760,
    "artifact_bytes_max": 1073741824,
    "processes_max": 512
  },
  "isolation": {
    "host_socket": false,
    "privileged": false,
    "ambient_credentials": false,
    "host_devices": false,
    "cross_job_workspace": false,
    "cleanup_failure_terminal_state": "quarantined"
  },
  "admission": {
    "repository_ref_sha_bound": true,
    "dispatch_request_id_and_sha256_digest_required": true,
    "fixed_profile_and_runner_target_required": true,
    "delivery_id_required": true,
    "idempotency_key_required": true,
    "lease_nonce_required": true,
    "replay_is_terminal_duplicate": true,
    "terminal_receipt_required": true
  }
}
