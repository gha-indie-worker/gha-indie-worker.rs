// Oreslang-native file-route inventory, RPC and Lambda source adapters.
// No Rust generator. The Java/Graal stdlib provides scoped fs.list_dir,
// fs.is_dir, fs.is_symlink and literal string primitives (source.java PR #496).
//
// CLI policy: never report a successful operation without a verified action
// receipt. Host executable invocation remains in the narrow Bash launcher.

// The reference runtime currently resolves constants at code-unit scope,
// not through nested callable environments. Keep source markers in functions.
fnc generated_marker(): String {
  return "// @generated by oreslang-stack-cli; DO NOT EDIT.\n";
}

fnc inventory_schema(): String {
  return "oreslang.stack.inventory/v1";
}

fnc error(String message): String {
  return "ERROR: " + message;
}

fnc is_error(String result): bool {
  return result.starts_with("ERROR:");
}

fnc quote_json(String raw): String {
  val String escaped = raw.replace_literal("\\", "\\\\")
    .replace_literal("\"", "\\\"")
    .replace_literal("\n", "\\n")
    .replace_literal("\r", "\\r")
    .replace_literal("\t", "\\t");
  return "\"" + escaped + "\"";
}

fnc repository_role(String root): String {
  val String path = root + "/oreslang-stack.toml";
  if fs.is_symlink(path); then
    return error("project manifest is a symlink");
  fi
  if !fs.exists(path); then
    return error("missing oreslang-stack.toml");
  fi
  val lines = fs.read_text(path).split_literal("\n");
  let String section = "";
  let String role = "";
  for const raw of lines {
    val String line = raw.trim();
    if line == "" | line.starts_with("#"); then
      continue;
    fi
    if line.starts_with("["); then
      if line != "[repository]"; then
        return error("unsupported oreslang-stack.toml section");
      fi
      section = "repository";
    else
      val parts = line.split_literal("=");
      if parts.size != 2 | section != "repository" | parts[0].trim() != "role" | role != ""; then
        return error("expected exactly one [repository] role");
      fi
      role = parts[1].trim();
    fi
  }
  if role == "\"api\""; then return "api"; fi
  if role == "\"admin-api\""; then return "admin-api"; fi
  if role == "\"web\""; then return "web"; fi
  if role == "\"admin-web\""; then return "admin-web"; fi
  return error("invalid repository role; expected api|admin-api|web|admin-web");
}

fnc is_api(String role): bool {
  if role == "api" | role == "admin-api"; then return true; fi
  return false;
}

fnc route_path(String route, String segment): String {
  if !segment.is_route_segment(); then
    return error("invalid filesystem route segment: " + segment);
  fi
  let String component = segment;
  if segment.starts_with("["); then
    component = "{" + segment.replace_literal("[", "").replace_literal("]", "") + "}";
  fi
  if route == "/"; then return "/" + component; fi
  return route + "/" + component;
}

fnc route_shape(String shape, String segment): String {
  let String component = segment;
  if segment.starts_with("["); then component = "{}"; fi
  if shape == "/"; then return "/" + component; fi
  return shape + "/" + component;
}

// Return "" on success, ERROR on refusal. The native guest owns all writes.
// Dry pass checks ownership and signatures before any output mutation.
fnc sync_one(String path, String generated, bool check, bool dry): String {
  if fs.is_symlink(path); then
    return error("symlinked output: " + path);
  fi
  if fs.exists(path); then
    val String previous = fs.read_text(path);
    if path.ends_with(".ores"), !previous.starts_with(generated_marker()); then
      return error("refusing to overwrite hand-authored code: " + path);
    fi
    if path.ends_with(".json"), !previous.starts_with("{\n  \"schema\": \"oreslang.stack.inventory/v1\""); then
      return error("refusing to overwrite unowned route manifest: " + path);
    fi
    if check, previous != generated; then
      return error("stale generated output: " + path);
    fi
    if previous == generated; then
      return "";
    fi
  else
    if check; then return error("missing generated output: " + path); fi
  fi
  if !dry, !check; then
    fs.write_text_atomic(path, generated);
  fi
  return "";
}

fnc http_method(String method): bool {
  if method == "GET" | method == "POST" | method == "PUT" |
    method == "PATCH" | method == "DELETE" | method == "HEAD" |
    method == "OPTIONS"; then
    return true;
  fi
  return false;
}

// On success returns newline-terminated manifest row(s).
fnc api_leaf(String root, String dir, String url, String kind, bool check, bool dry): String {
  val String path = dir + "/route.ores";
  val String handler_path = dir + "/handlers.ores";
  if fs.is_symlink(path) | fs.is_symlink(handler_path); then
    return error("symlinked route source or handlers: " + dir);
  fi
  if !fs.exists(handler_path); then
    return error("route.ores requires sibling handlers.ores: " + dir);
  fi
  val String source = fs.read_text(path);
  val String handlers = fs.read_text(handler_path);
  let String manifest = "";
  let String rpc = generated_marker() + "// Transport-neutral RPC adapters; typed transports remain host-specific.\nimport module route from \"./route\";\n\ndefine module rpc as\n";
  let String lambda = generated_marker() + "// Oreslang Lambda source exports; runtime transport must be admitted.\nimport module rpc from \"./rpc\";\n\ndefine module lambda as\n";
  let String seen = "|";
  let count = 0;
  for const raw of source.split_literal("\n") {
    val String line = raw.trim();
    if !line.starts_with("// @ores-route"); then continue; fi
    val fields = line.split_literal(" ");
    if fields.size != 5 | fields[0] != "//" | fields[1] != "@ores-route"; then
      return error("invalid route annotation: " + path);
    fi
    val String method = fields[2];
    val String declared = fields[3];
    val String symbol = fields[4];
    if !http_method(method) | declared != url | !symbol.is_identifier(); then
      return error("invalid HTTP method, path or handler: " + line);
    fi
    if seen.contains_literal("|" + method + "|") | seen.contains_literal("|@" + symbol + "|"); then
      return error("duplicate HTTP method or RPC symbol: " + path);
    fi
    if !handlers.contains_literal("pub fnc " + symbol + "(String request)") |
      !source.contains_literal("pub fnc " + symbol + "(String request)") |
      !source.contains_literal("handlers." + symbol + "(request)"); then
      return error("route must forward public String handler: " + symbol);
    fi
    seen = seen + method + "|@" + symbol + "|";
    rpc = rpc + "pub fnc rpc_" + symbol + "(String request) -> String {\n  return route." + symbol + "(request);\n}\n\n";
    lambda = lambda + "pub fnc invoke_" + symbol + "(String request) -> String {\n  return rpc.rpc_" + symbol + "(request);\n}\n\n";
    manifest = manifest + "@J|{\"kind\":\"route\",\"method\":" + quote_json(method) +
      ",\"path\":" + quote_json(url) +
      ",\"handler\":" + quote_json(symbol) +
      ",\"source\":" + quote_json(dir.replace_literal(root + "/", "") + "/route.ores") + "}\n";
    count = count + 1;
  }
  if count == 0; then return error("no @ores-route declarations: " + path); fi
  rpc = rpc + "end\n";
  lambda = lambda + "end\n";

  if kind == "all" | kind == "rpc"; then
    val String status = sync_one(dir + "/rpc.ores", rpc, check, dry);
    if is_error(status); then return status; fi
  fi
  if kind == "all" | kind == "lambda"; then
    // Generated Lambda uses the generated RPC module. No implicit creation
    // when only "lambda" was requested.
    val String rpc_status = sync_one(dir + "/rpc.ores", rpc, true, true);
    if kind == "lambda", is_error(rpc_status); then
      return error("Lambda requires current RPC adapter: " + dir);
    fi
    val String status = sync_one(dir + "/lambda.ores", lambda, check, dry);
    if is_error(status); then return status; fi
  fi
  return manifest;
}

fnc web_leaf(String root, String dir, String url, String kind, bool check, bool dry): String {
  if kind == "rpc"; then
    return error("web pages do not produce RPC operations");
  fi
  val String path = dir + "/page.ores";
  if fs.is_symlink(path); then return error("symlinked page source: " + path); fi
  val String source = fs.read_text(path);
  let String renderer = "";
  for const raw of source.split_literal("\n") {
    val String line = raw.trim();
    if !line.starts_with("// @ores-page"); then continue; fi
    val fields = line.split_literal(" ");
    if fields.size != 4 | fields[0] != "//" | fields[1] != "@ores-page" |
      fields[2] != url | !fields[3].is_identifier() | renderer != ""; then
      return error("invalid or duplicate @ores-page: " + path);
    fi
    renderer = fields[3];
  }
  if renderer == "" | !source.contains_literal("pub fnc " + renderer + "(String request)"); then
    return error("page requires public String renderer: " + path);
  fi
  val String lambda = generated_marker() + "// Web Lambda adapter; server supplies request/response transport.\n" +
    "import module page from \"./page\";\n\ndefine module lambda as\n" +
    "pub fnc invoke_page(String request) -> String {\n  return page." + renderer + "(request);\n}\nend\n";
  if kind == "all" | kind == "lambda"; then
    val String status = sync_one(dir + "/lambda.ores", lambda, check, dry);
    if is_error(status); then return status; fi
  fi
  return "@J|{\"kind\":\"page\",\"path\":" + quote_json(url) +
    ",\"handler\":" + quote_json(renderer) +
    ",\"source\":" + quote_json(dir.replace_literal(root + "/", "") + "/page.ores") + "}\n";
}

// Recursive *Oreslang* directory discovery. The directory list is sorted by
// the guest stdlib, so source manifest rows and generated bytes are stable.
fnc walk(String root, String dir, String url, String shape,
         String role, String kind, bool check, bool dry, int depth): String {
  if depth > 32; then return error("route nesting exceeds 32: " + dir); fi
  if fs.is_symlink(dir); then return error("symlinked route directory: " + dir); fi
  if !fs.is_dir(dir); then return error("missing source directory: " + dir); fi
  val api = is_api(role);
  val String leaf_name = api ? "route.ores" : "page.ores";
  let String result = "";
  val String leaf_path = dir + "/" + leaf_name;
  val has_leaf = fs.exists(leaf_path);
  if has_leaf; then
    val String manifest = api ? api_leaf(root, dir, url, kind, check, dry) :
      web_leaf(root, dir, url, kind, check, dry);
    if is_error(manifest); then return manifest; fi
    result = "@S|" + shape + "|\n" + manifest;
  fi

  for const raw_name of fs.list_dir(dir) {
    val String name = raw_name;
    val String child = dir + "/" + name;
    if fs.is_symlink(child); then
      return error("symlink in route tree: " + child);
    fi
    if fs.is_dir(child); then
      val String next_url = route_path(url, name);
      if is_error(next_url); then return next_url; fi
      val String next_shape = route_shape(shape, name);
      val String nested = walk(root, child, next_url, next_shape, role, kind, check, dry, depth + 1);
      if is_error(nested); then return nested; fi
      result = result + nested;
    else
      if name == "rpc.ores" | name == "lambda.ores"; then
        let bool targeted = false;
        if kind == "all"; then targeted = true; fi
        if kind == "rpc", name == "rpc.ores"; then targeted = true; fi
        if kind == "lambda", name == "lambda.ores"; then targeted = true; fi
        let bool valid = false;
        if has_leaf; then
          if api; then
            if name == "rpc.ores" | name == "lambda.ores"; then
              valid = true;
            fi
          else
            if name == "lambda.ores"; then valid = true; fi
          fi
        fi
        if targeted, !valid; then
          val String old = fs.read_text(child);
          if !old.starts_with(generated_marker()); then
            return error("unowned adapter in route tree: " + child);
          fi
          if check; then return error("orphan generated adapter: " + child); fi
          if !dry; then fs.remove(child); fi
        fi
      fi
    fi
  }
  return result;
}

fnc manifest_from_records(String role, String records): String {
  let String seen_shapes = "|";
  let String json_rows = "";
  let count = 0;
  for const raw_line of records.split_literal("\n") {
    val String line = raw_line;
    if line.starts_with("@S|"); then
      if seen_shapes.contains_literal(line); then
        return error("ambiguous dynamic route path shape: " + line);
      fi
      seen_shapes = seen_shapes + line;
    else
      if line.starts_with("@J|"); then
        if count > 0; then json_rows = json_rows + ",\n"; fi
        json_rows = json_rows + "    " + line.replace_literal("@J|", "");
        count = count + 1;
      fi
    fi
  }
  if count == 0; then return error("no route/page.ores sources discovered"); fi
  return "{\n  \"schema\": " + quote_json(inventory_schema()) +
    ",\n  \"role\": " + quote_json(role) +
    ",\n  \"entries\": [\n" + json_rows + "\n  ]\n}\n";
}

fnc route_manifest(String root, String role, String kind, bool check, bool dry): String {
  val String folder = is_api(role) ? "routes" : "pages";
  val String path = root + "/src/" + folder;
  val String records = walk(root, path, "/", "/", role, kind, check, dry, 0);
  if is_error(records); then return records; fi
  return manifest_from_records(role, records);
}

fnc generate(String root, String role, String kind, bool check): String {
  if kind != "all", kind != "rpc", kind != "lambda"; then
    return error("generate expects all|rpc|lambda");
  fi
  if !is_api(role), kind == "rpc"; then
    return error("web pages do not produce RPC operations");
  fi
  // Phase 1: validate every source and pre-existing artifact before writes.
  val String inspected = route_manifest(root, role, kind, false, true);
  if is_error(inspected); then return inspected; fi

  // Manifest path ownership must be admitted before changing any adapter.
  // In particular, a hand-authored manifest cannot cause partial generation.
  if kind == "all"; then
    val String parent = root + "/generated";
    if fs.is_symlink(parent); then return error("generated manifest parent is symlink"); fi
    if fs.exists(parent), !fs.is_dir(parent); then
      return error("generated manifest parent is not a directory");
    fi
    if fs.exists(parent); then
      val String existing = sync_one(parent + "/route-manifest.json", inspected, check, true);
      if is_error(existing); then return existing; fi
    else
      if check; then return error("missing generated output: " + parent); fi
    fi
  fi

  // Phase 2: verify or materialize byte-stable Oreslang adapters.
  val String manifest = route_manifest(root, role, kind, check, false);
  if is_error(manifest); then return manifest; fi
  if kind == "all"; then
    val String parent = root + "/generated";
    if !fs.exists(parent); then fs.mkdir_all(parent); fi
    val String state = sync_one(parent + "/route-manifest.json", manifest, check, false);
    if is_error(state); then return state; fi
  fi
  return "";
}

fnc admission(String root, String entry, String action): String {
  val String role = repository_role(root);
  if is_error(role); then return role; fi
  val String entry_path = root + "/" + entry;
  if fs.is_symlink(entry_path) | !fs.exists(entry_path); then
    return error("missing or symlinked Oreslang application entrypoint");
  fi
  if action == "routes"; then
    // Source inventory is intentionally independent of previously generated
    // adapters. This action needs no write capability.
    return route_manifest(root, role, "routes", false, true);
  fi
  if action == "deploy"; then
    return error("deploy denied: no certified compiler artifact or host adapter");
  fi
  if action == "generate"; then
    val String kind = env.get("ORESLANG_STACK_KIND").unwrap();
    val String check = env.get("ORESLANG_STACK_CHECK").unwrap();
    val String result = generate(root, role, kind, check == "true");
    if is_error(result); then return result; fi
    return "ORESLANG_STACK_ACTION_v1:generated";
  fi
  if action == "check"; then
    val String result = generate(root, role, "all", true);
    if is_error(result); then return result; fi
    return "ORESLANG_STACK_ACTION_v1:check";
  fi
  if action == "dev" | action == "build"; then
    val String result = generate(root, role, "all", false);
    if is_error(result); then return result; fi
    return "ORESLANG_STACK_ACTION_v1:" + action;
  fi
  return error("unknown command: " + action);
}

pub routine main(): void {
  val String command = env.get("ORESLANG_STACK_COMMAND").unwrap();
  val String root = env.get("ORESLANG_STACK_ROOT").unwrap();
  val String entry = env.get("ORESLANG_STACK_ENTRY").unwrap();
  val String backend = env.get("ORESLANG_STACK_BACKEND").unwrap();

  if command == "deploy"; then
    stdio.println(error("deploy denied: host adapter and runtime receipt are not certified"));
    return;
  fi
  if backend != "graal"; then
    stdio.println(error("LLVM backend is not ready for this CLI"));
    return;
  fi
  val String result = admission(root, entry, command);
  if command == "routes", !is_error(result); then
    stdio.println("ORESLANG_STACK_JSON_v1:" + result);
  else
    stdio.println(result);
  fi
  return;
}
