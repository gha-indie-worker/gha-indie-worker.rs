{
  "version": 1,
  "gate": "G3",
  "namespace": "std/compute",
  "trustedRuntimeOnly": true,
  "sourceSyntaxEnabled": false,
  "implicitCpuFallback": false,
  "physicalProvider": {
    "backend": "opencl-1.2",
    "dynamicRuntimeLoadingAllowed": true,
    "runtimeReflectionRequired": false,
    "guestCanLoadProvider": false,
    "opaquePhysicalAllocationCapabilities": true,
    "opaqueQueueCapabilities": true,
    "opaqueDeviceEvents": true,
    "queueCapabilityBoundToDeviceAuthority": true,
    "queueCapabilityGenerationRequired": true,
    "artifactAbiValidationRequired": true,
    "providerReleaseRetryable": true
  },
  "quotas": {
    "perTenantDevice": true,
    "residentBytes": "required",
    "pinnedHostBytes": "required",
    "outstandingEvents": "required",
    "queueSlots": "required",
    "checkedSignedI64Arithmetic": true,
    "reserveBeforeFenceClaim": true,
    "residentReleaseAfterPhysicalRelease": true
  },
  "operationStates": [
    "planned",
    "quota-held",
    "fences-reserved",
    "submitted",
    "device-terminal",
    "cancel-requested",
    "cancel-quiescent",
    "host-fences-terminal",
    "released",
    "aborted-before-submit",
    "device-lost"
  ],
  "submissionRules": {
    "markSubmittedOnlyAfterDurableEnqueue": true,
    "preEnqueueFailureUsesExactAbort": true,
    "submittedWorkCannotUseAbort": true,
    "completionRequiresExactProviderEvent": true,
    "cancellationImpliesQuiescence": false,
    "releaseRequiresQuiescence": true,
    "deviceLossPoisonsOutstandingAllocations": true,
    "timeoutDoesNotFreeDeviceMemory": true,
    "preEnqueueCleanupFailureRetainsRecoveryAuthority": true,
    "preEnqueueCleanupRetryRequired": true,
    "programReleaseFailureRetainsPreparedAuthority": true,
    "deviceLossDoesNotImplyQuiescence": true,
    "deviceLossRecoveryRequiresProviderProof": true,
    "deviceLossRetainsQuotaUntilRecovery": true,
    "providerRetainsSubmittedOperationAuthority": true,
    "callerHandleDropCannotReleasePhysicalResources": true,
    "deviceLossDominatesCancellation": true,
    "lostDeviceEventRetainedUntilRecoveryProof": true,
    "cancelThenDeviceLossRequiresRecovery": true
  },
  "transfers": {
    "uploadExplicit": true,
    "downloadExplicit": true,
    "inputUploadBeforeKernel": true,
    "outputDownloadAfterDeviceSuccess": true,
    "hostDeviceAliasForbiddenWhileSubmitted": true
  },
  "testing": {
    "injectableOpenClAbiRequired": true,
    "deterministicProviderFailureTestsRequired": true,
    "realDeviceProbeConditional": true,
    "mockProviderSuccessIsNotGpuExecutionEvidence": true,
    "artifactEmissionIsNotGpuExecutionEvidence": true,
    "realGpuExecutionEvidenceRequiresDeviceEvent": true,
    "preEnqueueReleaseFailureRecoveryRequired": true,
    "programReleaseRetryRequired": true,
    "queueAuthorityForgeryRequired": true,
    "deviceLossRecoveryFailureRetainsResources": true,
    "deviceLossRecoverySuccessRequired": true,
    "callerHandleDropRetentionRequired": true
  },
  "promotion": {
    "requiresJavaProviderStateParity": true,
    "requiresNativeProviderStateParity": true,
    "requiresQuotaRollbackTests": true,
    "requiresPreAndPostEnqueueFailureTests": true,
    "requiresTimeoutAndDeviceLossTests": true,
    "requiresSourceSyntaxToRemainFailClosed": true,
    "requiresArtifactAbiProviderValidation": true,
    "requiresRecoverablePreEnqueueCleanup": true,
    "requiresOpaqueJavaQueueAuthority": true,
    "requiresDeviceLossQuiescenceProof": true,
    "requiresProviderOwnedActiveOperationRegistry": true
  }
}
